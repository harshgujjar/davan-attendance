 "bsod": {
  "0x1A": {
   "lv": "red",
   "vk": "ram",
   "w": "RAM error (memory management)"
  },
  "0x50": {
   "lv": "red",
   "vk": "ram",
   "w": "RAM or driver read bad memory"
  },
  "0x7A": {
   "lv": "red",
   "vk": "disk",
   "w": "Disk could not be read (kernel data in-page)"
  },
  "0xEF": {
   "lv": "orange",
   "vk": "windows",
   "w": "A key Windows process died - Windows damaged or disk errors"
  },
  "0x124": {
   "lv": "red",
   "vk": "hardware",
   "w": "Hardware error (CPU / RAM / power / heat)"
  },
  "0x133": {
   "lv": "orange",
   "vk": "disk_driver",
   "w": "Disk / storage driver stopped answering (DPC watchdog)"
  },
  "0x116": {
   "lv": "orange",
   "vk": "display",
   "w": "Display driver stopped answering"
  },
  "0x119": {
   "lv": "orange",
   "vk": "display",
   "w": "Display driver scheduler error"
  },
  "0xD1": {
   "lv": "orange",
   "vk": "driver",
   "w": "A driver used a bad address - the named driver"
  },
  "0x3B": {
   "lv": "orange",
   "vk": "driver",
   "w": "System service error - the named driver"
  },
  "0x7E": {
   "lv": "orange",
   "vk": "driver",
   "w": "System thread error - the named driver"
  },
  "0x7F": {
   "lv": "red",
   "vk": "hardware",
   "w": "Unexpected CPU trap - RAM or overheating"
  },
  "0x9F": {
   "lv": "orange",
   "vk": "driver",
   "w": "Driver power state failure (sleep / wake)"
  },
  "0xC2": {
   "lv": "orange",
   "vk": "driver",
   "w": "Bad pool caller - the named driver"
  },
  "0x139": {
   "lv": "orange",
   "vk": "driver",
   "w": "Kernel security check - a driver or RAM"
  },
  "0x154": {
   "lv": "red",
   "vk": "disk",
   "w": "Unexpected store exception - disk failing"
  },
  "0x7B": {
   "lv": "red",
   "vk": "disk",
   "w": "Windows cannot find its boot disk (storage driver / BIOS SATA mode / disk)"
  },
  "0x24": {
   "lv": "orange",
   "vk": "disk",
   "w": "NTFS file system error - run Check disk"
  },
  "0x4E": {
   "lv": "red",
   "vk": "ram",
   "w": "PFN list corrupt - RAM"
  },
  "0xA": {
   "lv": "orange",
   "vk": "driver",
   "w": "IRQL not less or equal - a driver or RAM"
  },
  "0x1E": {
   "lv": "orange",
   "vk": "driver",
   "w": "Kernel mode exception - the named driver"
  },
  "0xC000021A": {
   "lv": "orange",
   "vk": "windows",
   "w": "Windows login process failed - Windows damaged"
  },
  "0x101": {
   "lv": "red",
   "vk": "hardware",
   "w": "CPU core stopped answering (clock watchdog) - CPU / BIOS / heat"
  },
  "0xF4": {
   "lv": "red",
   "vk": "disk",
   "w": "Critical process died - disk or cable"
  }
 },
 "rules": [
  {
   "id": "disk_smart",
   "lv": "red",
   "vk": "disk_failing",
   "v": "Disk failing",
   "conf": 90,
   "any": [
    [
     "smart.realloc",
     ">",
     0
    ],
    [
     "smart.pending",
     ">",
     0
    ],
    [
     "smart.uncorr",
     ">",
     0
    ],
    [
     "ev.disk7",
     ">",
     0
    ]
   ],
   "why": "Bad sectors: {smart.realloc} reallocated, {smart.pending} pending, {smart.uncorr} uncorrectable; Disk 7 bad-block events: {ev.disk7}. Copy files off and swap the disk.",
   "fix": "ssd_swap"
  },
  {
   "id": "disk_cable",
   "lv": "orange",
   "vk": "disk_cable",
   "v": "Disk cable / port errors",
   "conf": 75,
   "all": [
    [
     "smart.crc",
     ">",
     20
    ]
   ],
   "why": "{smart.crc} CRC errors = a loose or bad SATA cable. Re-seat or change the cable.",
   "fix": "check_disk"
  },
  {
   "id": "disk_slow",
   "lv": "orange",
   "vk": "disk_slow",
   "v": "Disk very slow",
   "conf": 70,
   "all": [
    [
     "perf.latP95",
     ">",
     150
    ],
    [
     "perf.busyP95",
     ">",
     90
    ]
   ],
   "why": "Disk answers in {perf.latP95} ms (healthy < 20 ms) and is busy {perf.busyP95}% of the time. An old HDD - an SSD fixes this.",
   "fix": "ssd_swap"
  },
  {
   "id": "ssd_wear",
   "lv": "orange",
   "vk": "ssd_wear",
   "v": "SSD worn out",
   "conf": 80,
   "all": [
    [
     "smart.wear",
     ">=",
     90
    ]
   ],
   "why": "SSD wear {smart.wear}% used."
  },
  {
   "id": "ram_whea",
   "lv": "red",
   "vk": "ram_error",
   "v": "RAM error",
   "conf": 85,
   "any": [
    [
     "ev.whea",
     ">",
     0
    ],
    [
     "mdiag.fail",
     ">",
     0
    ],
    [
     "bsod.ram",
     ">",
     0
    ]
   ],
   "why": "Hardware memory errors: WHEA {ev.whea}, Memory Diagnostic failures {mdiag.fail}, RAM blue screens (2 or more) {bsod.ram}. Run the RAM test; re-seat or replace the stick.",
   "fix": "ram_test"
  },
  {
   "id": "ram_bsod1",
   "lv": "orange",
   "vk": "ram_watch",
   "v": "Watch RAM",
   "conf": 55,
   "all": [
    [
     "bsod.ram1",
     ">",
     0
    ]
   ],
   "why": "One blue screen with a memory-type code (often a driver or software, not a bad stick). No hardware memory errors (WHEA) and no failed memory test. Watching - a second one makes it a RAM error."
  },
  {
   "id": "ram_low",
   "lv": "orange",
   "vk": "ram_low",
   "v": "Too little RAM",
   "conf": 75,
   "all": [
    [
     "perf.ramP95",
     ">=",
     92
    ],
    [
     "perf.faultsP95",
     ">",
     300
    ]
   ],
   "why": "RAM {perf.ramP95}% full at busy times and Windows pages to disk {perf.faultsP95} times/s. {inv.ramGB} GB is not enough for {top.ram} - add RAM.",
   "fix": "stop_program"
  },
  {
   "id": "ram_mismatch",
   "lv": "yellow",
   "vk": "ram_mismatch",
   "v": "RAM sticks do not match",
   "conf": 60,
   "all": [
    [
     "inv.ramMismatch",
     ">",
     0
    ]
   ],
   "why": "Sticks of different size / speed: {inv.ramSticks}. Dual channel is off - slower."
  },
  {
   "id": "win_damaged",
   "lv": "orange",
   "vk": "windows_damaged",
   "v": "Windows damaged",
   "conf": 70,
   "any": [
    [
     "sfc.bad",
     ">",
     0
    ],
    [
     "bsod.windows",
     ">",
     0
    ],
    [
     "ev.scm",
     ">",
     10
    ]
   ],
   "why": "sfc found {sfc.bad} damaged files; {ev.scm} service start failures. Repair Windows (sfc / DISM) runs in the background.",
   "fix": "repair_windows"
  },
  {
   "id": "hang",
   "lv": "orange",
   "vk": "app_hang",
   "v": "Program hangs",
   "conf": 70,
   "all": [
    [
     "ev.hangTopN",
     ">=",
     3
    ]
   ],
   "why": "{ev.hangTop} hung {ev.hangTopN} times in 7 days.",
   "fix": "stop_program"
  },
  {
   "id": "heat",
   "lv": "orange",
   "vk": "overheating",
   "v": "Overheating",
   "conf": 75,
   "any": [
    [
     "perf.tempMax",
     ">=",
     90
    ],
    [
     "ev.throttle",
     ">",
     5
    ],
    [
     "perf.freqMin",
     "<",
     60
    ]
   ],
   "why": "CPU reached {perf.tempMax} °C; slowed down {ev.throttle} times (down to {perf.freqMin}% speed). Clean the dust and fan, check the thermal paste."
  },
  {
   "id": "cfull",
   "lv": "orange",
   "vk": "disk_full",
   "v": "Disk almost full",
   "conf": 90,
   "all": [
    [
     "disk.cFreePct",
     "<",
     15
    ]
   ],
   "why": "C: has {disk.cFreeGB} GB free ({disk.cFreePct}%). Android files: {disk.androidGB} GB. Clean now frees about {disk.cleanGB} GB.",
   "fix": "clean"
  },
  {
   "id": "updloop",
   "lv": "orange",
   "vk": "update_loop",
   "v": "Update loop (Deep Freeze)",
   "conf": 80,
   "all": [
    [
     "upd.loop",
     ">",
     0
    ]
   ],
   "why": "The same update downloaded {upd.loopN} times - Deep Freeze wipes it at every restart. Thaw once so it can install.",
   "fix": "thaw_update"
  },
  {
   "id": "printer",
   "lv": "orange",
   "vk": "printer_error",
   "v": "Printer error",
   "conf": 70,
   "any": [
    [
     "prn.err",
     ">",
     0
    ],
    [
     "prn.stuck",
     ">",
     0
    ]
   ],
   "why": "Printer {prn.name}: {prn.code} ({prn.err} errors, {prn.stuck} stuck jobs).",
   "fix": "printer_fix"
  },
  {
   "id": "bootslow",
   "lv": "yellow",
   "vk": "slow_startup",
   "v": "Slow startup",
   "conf": 70,
   "all": [
    [
     "boot.sec",
     ">",
     120
    ]
   ],
   "why": "Power on to desktop took {boot.sec} s. Slowest: {boot.top}.",
   "fix": "startup_off"
  },
  {
   "id": "power",
   "lv": "yellow",
   "vk": "power_cuts",
   "v": "Power cuts / no UPS",
   "conf": 70,
   "all": [
    [
     "ev.kp41nob",
     ">=",
     2
    ]
   ],
   "why": "Switched off without shutting down {ev.kp41nob} times in 7 days (Kernel-Power 41, no blue screen) - power cuts or loose power cable. A UPS helps."
  },
  {
   "id": "cmos",
   "lv": "yellow",
   "vk": "cmos_battery",
   "v": "CMOS battery weak",
   "conf": 65,
   "all": [
    [
     "ev.clockJump",
     ">",
     0
    ]
   ],
   "why": "Clock jumped back at start {ev.clockJump} times - replace the CMOS battery (CR2032)."
  },
  {
   "id": "net",
   "lv": "yellow",
   "vk": "network",
   "v": "Network problems",
   "conf": 60,
   "any": [
    [
     "net.ipConflict",
     ">",
     0
    ],
    [
     "net.gwMs",
     ">",
     100
    ],
    [
     "net.loss",
     ">",
     10
    ]
   ],
   "why": "IP conflicts {net.ipConflict}, gateway {net.gwMs} ms, {net.loss}% lost."
  },
  {
   "id": "bsod_any",
   "lv": "orange",
   "vk": "blue_screen",
   "v": "Blue screens",
   "conf": 60,
   "all": [
    [
     "bsod.n7",
     ">",
     0
    ]
   ],
   "why": "{bsod.n7} blue screen(s) in 7 days: {bsod.last}."
  }
 ],
